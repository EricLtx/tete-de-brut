# Copier ce fichier en .env (hors Git) et renseigner les valeurs ; aucune valeur n'est versionnée.
# Clé d'accès à l'API Oriane ; absente, le service tourne en mode enregistré.
ORIANE_API_KEY=
# Adresse de base de l'API Oriane (https://connect.oriane.xyz par défaut).
ORIANE_URL=
# Nom de l'en-tête HTTP qui porte la clé Oriane (Authorization par défaut).
ORIANE_EN_TETE_AUTH=
# Mot placé devant la clé dans cet en-tête, suivi d'une espace (Bearer par défaut ; aucun pour n'en poser aucun).
ORIANE_PREFIXE_AUTH=
# Délai d'expiration d'un appel Oriane, en secondes (20 par défaut).
ORIANE_DELAI_S=
# Origines CORS autorisées, séparées par des virgules, exactes (jamais *) ; vide, aucune origine.
ORIGINES_AUTORISEES=
# Clé de démonstration exigée dans X-Cle-Demo sur les écritures sous /v1 ; vide, service ouvert.
CLE_DEMO=
# auto (direct si la clé Oriane est présente) ou enregistre (rejoue toujours le cas enregistré).
MODE_DONNEES=
# Fichier SQLite du service (défaut : donnees/tete-de-brut.sqlite).
CHEMIN_BASE=
# Dossier du cas enregistré, hors Git (défaut : cas/).
CHEMIN_CAS=
# Plafond de crédits Oriane par jour (600 par défaut).
PLAFOND_CREDITS_JOUR=
# Port d'écoute du service (8080 par défaut).
PORT=
# Mode de rédaction du résumé de la fiche : gabarit ou modele (gabarit par défaut).
RESUME_MODE=
# Identifiant du modèle de langue, lu en configuration (S10 seulement).
MODELE_LANGUE_ID=
# Adresse de l'API du modèle de langue chez Scaleway (S10 seulement).
SCALEWAY_URL=
# Clé d'accès à l'API Scaleway (S10 seulement).
SCALEWAY_API_KEY=
# Fichier JSON des comptes à écarter d'une recherche, hors Git : {"partis": ["compte_a", "compte_b"]} (vide, aucune liste).
CHEMIN_COMPTES=
